# Discord bot (https://discord.com/developers/applications -> your app)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Role given to verified buyers (right-click role -> Copy Role ID)
CUSTOMER_ROLE_ID=
# Staff role that can see/close tickets and run admin commands
STAFF_ROLE_ID=
# Category channel where tickets are created
TICKET_CATEGORY_ID=
# Channel where closed-ticket transcripts are logged (optional)
TICKET_LOG_CHANNEL_ID=
# Channel where /vouch posts (optional; defaults to the channel it was run in)
VOUCH_CHANNEL_ID=
# Only members with the customer role can /vouch (true/false)
VOUCH_REQUIRES_CUSTOMER=true

# SellApp: Settings -> API -> create a key with the "invoice" ability
SELLAPP_API_KEY=
SELLAPP_STORE=plasmacheats

# Branding
SITE_NAME=Plasmacheats.com
LIVE_STATUS_URL=https://plasmacheats.com
